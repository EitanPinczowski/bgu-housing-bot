# Copy this file to ".env" and fill in your real values.
# .env is git-ignored — never commit it, never paste these into a chat.

# Gemini free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot (from @BotFather) and your own chat id (from @userinfobot).
# TELEGRAM_CHAT_ID may be a COMMA-SEPARATED list to also send alerts to a friend
# or a shared group (a group id is negative), e.g. 123456789,-1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional: Google Sheets sink (see README "Google Sheets") ---
# Put the service-account JSON at auth/google_service_account.json and the
# sheet's id (the long id in its URL) here. Leave blank to keep it disabled.
# GOOGLE_SHEET_ID=

# --- local model via Ollama (set LLM_PROVIDER="openai_compatible" in config.py) ---
# Install Ollama, run `ollama pull gemma2:9b`, then uncomment these:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma2:9b
# LLM_API_KEY=ollama

# --- optional: Yad2 as a second source, via its own saved-search ALERT EMAILS ---
# Scraping Yad2 is a closed decision (CAPTCHA-walled, and it would risk the home IP the
# Facebook scraper depends on). Reading your own mailbox is the legitimate route.
# Use an APP PASSWORD, never your account password, and prefer a dedicated address with a
# filter so only Yad2 alerts land there. The connection is read-only.
# Then: python yad2_mail.py --dump   (inspect)  ->  python yad2_mail.py --live
# YAD2_IMAP_HOST=imap.gmail.com
# YAD2_IMAP_USER=
# YAD2_IMAP_PASSWORD=
# YAD2_IMAP_FOLDER=INBOX
# YAD2_FROM=yad2
